# Build output and packaged artifacts. `dist` alone only matches the top-level directory, so the
# per-target staging trees and the release folder used for installer builds were still being
# tracked, which put hundreds of megabytes of binaries in the repository.
/dist
/dist-*
/out
packages/*/dist
packages/*/dist-*
packages/*/out
packages/desktop/vendor
packages/desktop/resources/opencode-cli*
*.7z
*.blockmap

# Installer payloads that ship with the app and are rebuilt from downloads, not source.
packages/desktop/resources/windows/firefox-devedition-setup.exe
packages/desktop/resources/wlstudio-cli.exe
packages/desktop/resources/wlstudio-cli.version

