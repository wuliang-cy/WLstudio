{
  "$schema": "https://opencode.ai/config.json",
  "model": "deepseek-wl001/deepseek-flash",
  "language": "zh",
  "instructions": [
    "~/WLstudio SE/SE-AGENTS.md",
    "~/WARMUP.md"
  ],
  "permissions": [
    { "action": "external_directory", "resource": "*", "effect": "allow" }
  ],
  "plugins": [
    "@tarquinen/opencode-dcp@latest"
  ],
  "providers": {
    "deepseek-wl001": {
      "name": "deepseek-wl001",
      "package": "@ai-sdk/openai-compatible",
      "settings": {
        "baseURL": "https://api.deepseek.com",
        "apiKey": "__DEEPSEEK_API_KEY__"
      },
      "models": {
        "deepseek-flash": {
          "name": "deepseek-flash",
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": {
            "context": 1000000,
            "output": 384000
          },
          "settings": {
            "openaiCompatible": {
              "thinking": { "type": "disabled" }
            }
          }
        },
        "deepseek-v4-pro": {
          "name": "deepseek-v4-pro",
          "limit": {
            "context": 1000000,
            "output": 384000
          },
          "settings": {
            "openaiCompatible": {
              "thinking": { "type": "disabled" }
            }
          }
        }
      }
    }
  }
}
